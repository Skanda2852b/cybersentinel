  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) / avg(rate(node_cpu_seconds_total[5m])))",
          "legendFormat": "CPU Usage",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "Memory Usage",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 3,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "rate(cybersentinel_events_total[5m])",
          "legendFormat": "Events/sec",
          "refId": "A"
        },
        {
          "expr": "rate(cybersentinel_alerts_total[5m])",
          "legendFormat": "Alerts/sec",
          "refId": "B"
        },
        {
          "expr": "rate(cybersentinel_incidents_total[5m])",
          "legendFormat": "Incidents/sec",
          "refId": "C"
        }
      ],
      "title": "Event Throughput",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"CRITICAL": {"color": "red", "index": 0}}, "type": "value"},
            {"options": {"HIGH": {"color": "orange", "index": 1}}, "type": "value"},
            {"options": {"MEDIUM": {"color": "yellow", "index": 2}}, "type": "value"},
            {"options": {"LOW": {"color": "blue", "index": 3}}, "type": "value"},
            {"options": {"INFO": {"color": "green", "index": 4}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""},
        "textMode": "auto"
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "sum by (severity) (cybersentinel_alerts_by_severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "title": "Alerts by Severity",
      "type": "piechart"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "rate(cybersentinel_detection_engine_evaluations_total[5m])",
          "legendFormat": "Evaluations/sec",
          "refId": "A"
        },
        {
          "expr": "rate(cybersentinel_alerts_created_total[5m])",
          "legendFormat": "Alerts Created/sec",
          "refId": "B"
        }
      ],
      "title": "Detection Engine Performance",
      "type": "timeseries"
    },
    {
      "datasource": "Loki",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 6,
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLines": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "orderByTime": "Desc"
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "{job=\"cybersentinel-backend\"} | json | level =~ \"ERROR|WARN\"",
          "refId": "A"
        }
      ],
      "title": "Recent Error Logs",
      "type": "logs"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 7,
      "options": {
        "legend": {"calcs": [], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(cybersentinel_detection_latency_seconds_bucket[5m]))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(cybersentinel_detection_latency_seconds_bucket[5m]))",
          "legendFormat": "P99 Latency",
          "refId": "B"
        },
        {
          "expr": "rate(cybersentinel_detection_latency_seconds_sum[5m]) / rate(cybersentinel_detection_latency_seconds_count[5m])",
          "legendFormat": "Avg Latency",
          "refId": "C"
        }
      ],
      "title": "Detection Engine Latency",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",

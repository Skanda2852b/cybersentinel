# Database
DATABASE_URL="postgresql://cybersentinel:cybersentinel@localhost:5432/cybersentinel"

# Backend
API_PORT=3000
NODE_ENV="development"
JWT_SECRET="super-secret-jwt-key-change-in-prod-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-prod-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
INGESTION_API_KEY="local-dev-ingestion-key-change-in-prod"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ML Service
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_TIMEOUT_MS=5000

# AI (Optional)
AI_PROVIDER="none"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Logging
LOG_LEVEL="debug"
LOG_PRETTY="true"

# Security
BCRYPT_ROUNDS=12
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
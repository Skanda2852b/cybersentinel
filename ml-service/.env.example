# ML Service Configuration
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
ML_SERVICE_WORKERS=4

# Model Configuration
MODEL_PATH=/app/models/isolation_forest.joblib
MODEL_VERSION=1.0.0
CONTAMINATION=0.01
N_ESTIMATORS=200
MAX_SAMPLES=256
RANDOM_STATE=42

# Feature Engineering
FEATURE_WINDOW_MINUTES=5
MIN_EVENTS_FOR_INFERENCE=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Training (optional)
TRAINING_DATA_PATH=/app/datasets/training_data.parquet
RETRAIN_SCHEDULE_CRON="0 3 * * 0"